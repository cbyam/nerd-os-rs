# Host builds (tests) only: the Kconfig values the Rust code uses that
# sdkconfig.defaults does not set, as in a generated sdkconfig (the firmware
# build reads the project's real sdkconfig instead, see build.rs).
CONFIG_ALERT_DISCORD_WATCHDOG_ENABLE_VALUE=0
CONFIG_ALERT_DISCORD_BLOCK_FOUND_ENABLE_VALUE=0
CONFIG_ALERT_DISCORD_BEST_DIFF_ENABLE_VALUE=0
CONFIG_ALERT_DISCORD_URL=""
CONFIG_LWIP_LOCAL_HOSTNAME="espressif"
CONFIG_MEMPOOL_URL="https://mempool.space"
CONFIG_OVERHEAT_TEMP=70
CONFIG_FAN_SPEED=100
CONFIG_STRATUM_URL="public-pool.io"
CONFIG_STRATUM_PORT=3333
CONFIG_STRATUM_USER="bc1q7n70rumyv6lvu8avpml0c3uggvssfu52egum3q.nerdqaxe"
CONFIG_STRATUM_PW="x"
CONFIG_STRATUM_ENONCE_SUBSCRIBE_VALUE=0
CONFIG_STRATUM_TLS_VALUE=0
CONFIG_STRATUM_FALLBACK_URL=""
CONFIG_STRATUM_FALLBACK_PORT=0
CONFIG_STRATUM_FALLBACK_USER=""
CONFIG_STRATUM_FALLBACK_PW=""
CONFIG_STRATUM_FALLBACK_ENONCE_SUBSCRIBE_VALUE=0
CONFIG_STRATUM_FALLBACK_TLS_VALUE=0
CONFIG_STRATUM_KEEPALIVE_ENABLE_VALUE=1
CONFIG_STRATUM_DIFFICULTY=1000
CONFIG_FAN_MODE_MANUAL=y
# CONFIG_FAN_MODE_PID is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
CONFIG_INFLUX_ENABLE_VALUE=0
CONFIG_INFLUX_URL="http://192.168.0.123"
CONFIG_INFLUX_PORT=8086
CONFIG_INFLUX_BUCKET="nerdqaxeplus"
CONFIG_INFLUX_ORG="nerdqaxeplus"
CONFIG_INFLUX_PREFIX="mainnet_stats"
CONFIG_ESP_WIFI_SSID="myssid"
CONFIG_ESP_WIFI_PASSWORD="mypassword"
CONFIG_SHOW_BLOCK_FOUND_ENABLE_VALUE=1
CONFIG_AUTO_SCREEN_OFF_VALUE=0
CONFIG_INFLUX_TOKEN="f37fh783hf8hq"
